###################
#iac/auth
###################
GCP_OAUTH_CLIENT_ID=<GCP_OAUTH_CLIENT_ID>
GCP_OAUTH_CLIENT_SECRET=<GCP_OAUTH_CLIENT_SECRET>

###################
# Backend
###################
# Taxonomy database settings
TAXONOMY_MONGODB_URI=<MONGODB_URI>
TAXONOMY_DATABASE_NAME=<DATABASE_NAME>
TAXONOMY_MODEL_ID=<MODEL_ID>

# Application database settings
APPLICATION_MONGODB_URI=<MONGODB_URI>
APPLICATION_DATABASE_NAME=<DATABASE_NAME>

# Metrics settings
METRICS_MONGODB_URI=<MONGODB_URI>
METRICS_DATABASE_NAME=<DATABASE_NAME>
BACKEND_ENABLE_METRICS=<True/False>

# Users database settings
USERDATA_MONGODB_URI=<URI_TO_MONGODB>
USERDATA_DATABASE_NAME=<DATABASE_NAME>

# Career Explorer database settings
CAREER_EXPLORER_MONGODB_URI=<URI_TO_MONGODB>
CAREER_EXPLORER_DATABASE_NAME=<DATABASE_NAME>

# Zambia jobs database settings
# Optional. Compass no longer owns a jobs collection - the matching service is the source -
# so the running service does not read these. They remain for the analytics scripts that are
# run by hand against a deployment. Leave them empty unless you run those.
JOBS_MONGODB_URI=/.*/
JOBS_DATABASE_NAME=/.*/
JOBS_COLLECTION_NAME=/.*/

# Google Cloud Platform settings
VERTEX_API_EMBEDDINGS_REGION=<REGIONAL_LOCATION>
VERTEX_API_GEN_AI_REGION=<REGIONAL_LOCATION_OR_GLOBAL>
EMBEDDINGS_SERVICE_NAME=/^GOOGLE-VERTEX-AI$/
EMBEDDINGS_MODEL_NAME=<EMBEDDINGS_MODEL_NAME>

# Sentry settings
BACKEND_SENTRY_DSN=<BACKEND_SENTRY_DSN>
BACKEND_ENABLE_SENTRY=<True/False>
BACKEND_SENTRY_CONFIG=<JSON_STRING>

# LLM tracing (Langfuse) settings - all optional, leave empty to deploy with tracing off.
# Use a self-hosted BACKEND_LANGFUSE_HOST for environments whose prompts carry user PII.
BACKEND_ENABLE_TRACING=<True/False>
BACKEND_LANGFUSE_HOST=<BACKEND_LANGFUSE_HOST>
BACKEND_LANGFUSE_PUBLIC_KEY=<BACKEND_LANGFUSE_PUBLIC_KEY>
BACKEND_LANGFUSE_SECRET_KEY=<BACKEND_LANGFUSE_SECRET_KEY>
BACKEND_TRACING_CONFIG=<JSON_STRING>

# LLM provider and per-tier model settings - all optional, leave empty to deploy on the Gemini defaults
# (gemini-3.5-flash-lite / gemini-3.8-flash / gemini-3.1-pro-preview). The Gemini 3.x models require VERTEX_API_GEN_AI_REGION=global.
# For a non-Gemini provider, an empty tier falls back to the next tier down that is set
# (deep reasoning -> reasoning -> default). See backend/.env.example for details.
LLM_PROVIDER=/.*/
LLM_DEFAULT_MODEL=/.*/
LLM_REASONING_MODEL=/.*/
LLM_DEEP_REASONING_MODEL=/.*/
ANTHROPIC_API_KEY=/.*/

# Country settings
DEFAULT_COUNTRY_OF_USER=<See backend/app/counties.py for valid values>

# JSON like configurations of the available features.
BACKEND_FEATURES=/.*/

# JSON like configuration for the experience pipeline
BACKEND_EXPERIENCE_PIPELINE_CONFIG=/.*/

# Career Explorer unified config (optional JSON: sectors, country)
# Example: {"sectors":[{"name":"Agriculture","description":"...","file":"agriculture.md"}],"country":"Zambia"}
CAREER_EXPLORER_CONFIG=/.*/

# CV limits (optional; digits)
BACKEND_CV_MAX_UPLOADS_PER_USER=/^[0-9]*$/
BACKEND_CV_RATE_LIMIT_PER_MINUTE=/^[0-9]*$/

# Admin user management (Identity Platform tenant where super_admin / admin / institution_staff users live).
# The admin panel is out of phase-1 scope: it needs an Identity Platform tenant that
# neither the IaC creates nor any document explains how to create, so these were
# being filled in with placeholder words to get past validation. Leave them empty
# unless you have created the tenant by hand and know what to put here.
ADMIN_FIREBASE_TENANT_ID=/.*/

###################
# Frontend
###################

# Metrics settings
FRONTEND_ENABLE_METRICS=<True/False>
FRONTEND_METRICS_CONFIG=/.*/

# Sentry settings
FRONTEND_ENABLE_SENTRY=<True/False>
FRONTEND_SENTRY_DSN=<FRONTEND_SENTRY_DSN>
FRONTEND_SENTRY_CONFIG=<JSON_STRING>

# Optional backend URL override for the frontend
CUSTOM_BACKEND_URL=/.*/

# PII settings
SENSITIVE_PERSONAL_DATA_RSA_ENCRYPTION_KEY=<PUBLIC_KEY_PEM_FORMAT>
SENSITIVE_PERSONAL_DATA_RSA_ENCRYPTION_KEY_ID=<KEY_ID>

# Invitation codes
FRONTEND_LOGIN_CODE=/.*/
FRONTEND_REGISTRATION_CODE=/.*/
GLOBAL_DISABLE_LOGIN_CODE=/.*/
GLOBAL_DISABLE_REGISTRATION_CODE=/.*/
FRONTEND_DISABLE_REGISTRATION=/.*/

FRONTEND_DISABLE_SOCIAL_AUTH=/.*/

# Other enabled Features

# CV Upload feature flag (optional, defaults to false if not set)
# This flag controls both frontend UI visibility and backend route registration
GLOBAL_ENABLE_CV_UPLOAD=/.*/

# New Session feature flag (optional, defaults to false if not set)
# This flag controls whether users can explicitly start new conversation sessions
FRONTEND_ENABLE_NEW_SESSION=/.*/

# Hides the program-skills section in 3 places: home dashboard sidebar, build your profile
# chat sidebar, and (as "Education Skills") the profile page. Shown by default; set "true" to hide.
FRONTEND_HIDE_PROGRAM_SKILLS=/.*/

# JSON like configurations of the available features.
FRONTEND_FEATURES=/.*/

# Matching service settings (Epic 3)
MATCHING_SERVICE_URL=/.*/
MATCHING_SERVICE_API_KEY=/.*/

BACKEND_LANGUAGE_CONFIG={"default_locale":"<Locale>","available_locales":[{"locale":"<Locale>","date_format":"<DateFormat>"}]}
FRONTEND_DEFAULT_LOCALE=<Locale>
FRONTEND_SUPPORTED_LOCALES=["<Locale-1>","<Locale-2>"]

# Branding
# Everything here is optional, and everything here is yours. Left unset, the deployment
# presents itself as Compass Connect with the product's own marks — never as some other
# organisation. There are no partner defaults to inherit by accident.
GLOBAL_PRODUCT_NAME=/.*/
# Country name shown in user-facing dashboard copy (optional; defaults to "your country" if unset)
GLOBAL_COUNTRY_NAME=/.*/
FRONTEND_BROWSER_TAB_TITLE=/.*/
FRONTEND_META_DESCRIPTION=/.*/
FRONTEND_LOGO_URL=/.*/
FRONTEND_DARK_LOGO_URL=/.*/
FRONTEND_FAVICON_URL=/.*/
FRONTEND_APP_ICON_URL=/.*/
FRONTEND_CHAT_AVATAR_URL=/.*/
# The address shown behind the footer's "Contact" link. Unset, the link is not shown at all.
FRONTEND_CONTACT_EMAIL=/.*/
# One line naming whoever runs and funds this deployment, shown in the footer. Unset, the
# footer credits Compass Connect rather than claiming a sponsor on your behalf.
FRONTEND_FOOTER_ATTRIBUTION=/.*/
FRONTEND_THEME_CSS_VARIABLES=/.*/
FRONTEND_SEO=/.*/
FRONTEND_ILLUSTRATIONS=/.*/
# Funder and partner logos for the footer, as a JSON array of {src, alt, height}. Unset, the
# footer shows none: a deployment credits the organisations it names and no others.
FRONTEND_PARTNER_LOGOS=/.*/
FRONTEND_SKILLS_REPORT_OUTPUT_CONFIG=/.*/

# Vanity domains, as JSON arrays, for deployments reached at an address of their own rather
# than the generated one. The first frontend entry is canonical: it is the domain Firebase
# puts in its sign-in emails and in the link that completes a password reset.
# e.g. FRONTEND_CUSTOM_DOMAINS=["example.org"]
FRONTEND_CUSTOM_DOMAINS=/.*/
ADMIN_FRONTEND_CUSTOM_DOMAINS=/.*/

# URL of the tutorial video embedded in the FAQ page. Unset, the page shows no video.
FRONTEND_FAQ_TUTORIAL_VIDEO_URL=/.*/

# Base URL the admin panel links its legal pages to, if they are published elsewhere.
LEGAL_SITE_BASE_URL=/.*/

# Sector knowledge hub. Off unless asked for: it is one country's catalogue of accredited
# institutions, programmes and critical skills, with that country's maps and editorial.
# With it on, name the sector pages you want - an empty list shows none.
# e.g. FRONTEND_KNOWLEDGE_HUB_SECTORS=["agriculture-pathway","mining-pathway"]
GLOBAL_ENABLE_KNOWLEDGE_HUB=/.*/
FRONTEND_KNOWLEDGE_HUB_SECTORS=/.*/

# Sensitive data fields
FRONTEND_SENSITIVE_DATA_FIELDS=/.*/

# Analytics / GTM
FRONTEND_GTM_CONTAINER_ID=/.*/
FRONTEND_GTM_ENABLED=/.*/

###################
# Admin Frontend
###################
# Admin frontend uses separate Firebase auth (manually created)
# The admin panel is out of phase-1 scope: it needs an Identity Platform tenant that
# neither the IaC creates nor any document explains how to create, so these were
# being filled in with placeholder words to get past validation. Leave them empty
# unless you have created the tenant by hand and know what to put here.
ADMIN_FRONTEND_FIREBASE_API_KEY=/.*/
ADMIN_FRONTEND_FIREBASE_AUTH_DOMAIN=/.*/
ADMIN_FRONTEND_FIREBASE_TENANT_ID=/.*/
